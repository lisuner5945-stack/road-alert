# Скопируйте этот файл в keystore.properties и заполните своими значениями.
# keystore.properties НЕ коммитится (см. .gitignore).
#
# Создать keystore:
# keytool -genkeypair -v -keystore road-alert-release.jks -alias road-alert \
#   -keyalg RSA -keysize 4096 -validity 10000
#
# Сохраните .jks, alias и пароли минимум в двух безопасных местах.
# Потеря ключа = невозможность обновлять приложение в RuStore.

storeFile=C:/keys/road-alert-release.jks
storePassword=CHANGE_ME
keyAlias=road-alert
keyPassword=CHANGE_ME
